{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/auth/kakao",
      "destination": "/api/auth/kakao"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/data).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
